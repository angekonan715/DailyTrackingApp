# Copy this file to .env.local and fill in values from
# Supabase dashboard > Project Settings > API.
# Use the project URL and the anon public key.
# Newer dashboards call that key the "publishable" key. Do not use the secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# One OpenAI key for the whole family (platform.openai.com). Server only — do not prefix with NEXT_PUBLIC_.
# The app calls gpt-4o-mini and stops at $5 per month for the family.
# On the published site, set this same name in the host’s environment variables. Do not commit the real key.
AI_API_KEY=

# Supabase secret key. Server only — do not prefix with NEXT_PUBLIC_. Needed so a key saved in
# Summary can be used by every family member without showing them the key. Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=
